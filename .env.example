# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Disaster Management System"
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_1234567890abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=disaster_mgmt
# Async database URL for FastAPI & async workers:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/disaster_mgmt
# Sync database URL for Alembic migrations:
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disaster_mgmt

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Replay & Demo Settings
REPLAY_SPEED_MULTIPLIER=1.0
DATA_STORAGE_PATH=./data
